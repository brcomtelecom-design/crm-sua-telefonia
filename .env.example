# Configuracoes do CRM Sua Telefonia
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
WEBSITE_ORIGIN=http://localhost:3000

# Armazenamento
DB_PATH=./data/crm.sqlite
TEMP_CAMPAIGN_DIR=./data/temp-campaigns
QR_AUTH_DIR=./data/qr-auth
BACKUP_DIR=./data/backups

# Administrador inicial
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Criptografia - gerar uma chave exclusiva de 32 bytes
APP_ENCRYPTION_KEY=

# Integracao Meta / WhatsApp Business
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=

# Limites de campanhas
CAMP_MAX_RECIPIENTS=5000
CAMP_MAX_IN_FLIGHT=5

# QR Web - desabilitado por padrao
QR_ENABLED=false
